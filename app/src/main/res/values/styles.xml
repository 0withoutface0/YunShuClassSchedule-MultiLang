<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme: no hardcoded colors -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme"/>
    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="AppTheme.WithActionBar" parent="Theme.Material3.DayNight"/>

    <!-- Toolbar overlays -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3"/>

    <!-- Keep these names (code references them) -->
    <style name="AppTheme_NightTheme" parent="AppTheme"/>
    <style name="AppTheme_NightTheme_Setting" parent="AppTheme"/>

    <!-- Your custom title style, now using theme roles -->
    <style name="custom_all_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>

</resources>
